diff --git a/worker-src/oferta-espanha-service.js b/worker-src/oferta-espanha-service.js
new file mode 100644
--- /dev/null
+++ b/worker-src/oferta-espanha-service.js
@@ -0,0 +1,64 @@
+import { offers, currency } from './oferta-espanha-catalog.js';
+import { loadPrices, priceFor } from './product-pricing.js';
+
+export function offerCheckout(env, db) {
+  function enabled() {
+    if (env.OFERTA_ESPANHA_ENABLED !== 'true') throw new Error('Oferta Espanha desativada');
+  }
+  return {
+    async price(key) {
+      enabled();
+      if (!Object.hasOwn(offers, key)) return null;
+      const { products } = await loadPrices(env);
+      const p = priceFor(products, 'oferta-espanha:' + key);
+      return { sale: Math.round(p.salePrice * 100), original: Math.round(p.originalPrice * 100) };
+    },
+    async quote(callback) {
+      enabled();
+      const rows = await db(env, 'oferta_espanha_checkout', '?callback=eq.' + encodeURIComponent(callback) + '&select=*&limit=1');
+      return rows[0] || null;
+    },
+    async reserve({ callback, key, amount, name, email }) {
+      const price = await this.price(key);
+      if (!price || price.sale !== amount) throw new Error('Preço alterado');
+      const quote = { callback, plan: key, amount_cents: amount, offer_id: callback, buyer_name: name, buyer_email: email };
+      try {
+        await db(env, 'oferta_espanha_checkout', '', 'POST', quote);
+        return quote;
+      } catch {
+        const old = await this.quote(callback);
+        if (old?.plan === key && old.amount_cents === amount && old.buyer_name === name && old.buyer_email === email) return old;
+        throw new Error('Checkout concorrente ou indisponível');
+      }
+    },
+    async record({ callback, offerId, transaction, status, amount, created, name, email, method }) {
+      enabled();
+      return db(env, 'rpc/oferta_espanha_record_payment', '', 'POST', {
+        p_callback: callback, p_offer: offerId, p_transaction: transaction, p_status: status,
+        p_amount: amount, p_created: created, p_name: name, p_email: email, p_method: method,
+      });
+    },
+    async status(callback) {
+      const quote = await this.quote(callback);
+      if (!quote) return null;
+      const rows = await db(env, 'oferta_espanha_orders', '?callback=eq.' + encodeURIComponent(callback) + '&select=status&order=created_at.desc&limit=1');
+      return { key: quote.plan, status: rows[0]?.status || 'pending' };
+    },
+  };
+}
+
+export async function listOfertaEspanha(env, db, offset, before) {
+  if (env.OFERTA_ESPANHA_ENABLED !== 'true') return [];
+  const query = new URLSearchParams({
+    select: 'id,plan,amount_cents,status,created_at,name,email,payment_method',
+    order: 'created_at.desc,id.desc', limit: '200', offset: String(offset),
+  });
+  if (before) query.set('created_at', 'lte.' + before);
+  const rows = await db(env, 'oferta_espanha_orders', '?' + query);
+  return rows.map(row => ({
+    id: row.id, transaction_id: row.id, created_at: row.created_at, name: row.name, email: row.email,
+    amount: row.amount_cents / 100, currency, status: row.status, gateway: 'stripe',
+    siteVariant: 'oferta-espanha', productId: row.plan, paymentMethod: 'card',
+    products: [{ name: offers[row.plan].name, quantity: 1 }],
+  }));
+}
