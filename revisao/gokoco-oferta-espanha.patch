@@ -0,0 +1,12 @@
+import { WorkerEntrypoint } from 'cloudflare:workers';
+import worker, { ofertaEspanhaCheckout } from '../dist/_worker.js';
+
+export default worker;
+
+export class OfertaEspanhaCheckout extends WorkerEntrypoint {
+  price(key) { return ofertaEspanhaCheckout(this.env).price(key); }
+  quote(token) { return ofertaEspanhaCheckout(this.env).quote(token); }
+  reserve(order) { return ofertaEspanhaCheckout(this.env).reserve(order); }
+  record(order) { return ofertaEspanhaCheckout(this.env).record(order); }
+  status(callback) { return ofertaEspanhaCheckout(this.env).status(callback); }
+}
